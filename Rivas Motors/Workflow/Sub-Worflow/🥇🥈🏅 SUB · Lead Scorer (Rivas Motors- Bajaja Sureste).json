    {
      "parameters": {
        "jsCode": "const t = $('When Executed by Another Workflow').item.json;\n\nconst PESOS = {\n  pide_prueba_manejo: 20,\n  pide_cita_visita: 18,\n  quiere_apartar_comprar: 20,\n  acepta_cita: 16,\n  declara_enganche: 15,\n  menciona_tiene_enganche: 15,\n  pide_cita_financiamiento: 14,\n  pide_precotizacion: 14,\n  confirma_horario_cita: 18,\n  pregunta_financiamiento: 12,\n  pregunta_modelo_especifico: 12,\n  pregunta_disponibilidad: 12,\n  interes_promo: 12,\n  pregunta_precio: 10,\n  declara_presupuesto: 10,\n  compara_modelos: 8,\n  da_telefono: 10,\n  da_email: 6,\n  da_ciudad: 6,\n  urgencia_alta: 10\n};\n\nconst HOT_EXPRES = new Set([\n  'quiere_apartar_comprar',\n  'acepta_cita',\n  'pide_prueba_manejo',\n  'pide_cita_visita',\n  'pide_cita_financiamiento',\n  'declara_enganche',\n  'menciona_tiene_enganche',\n  'confirma_horario_cita'\n]);\n\nfunction parseArr(v){ if(Array.isArray(v))return v; if(typeof v==='string'&&v.trim()){try{const p=JSON.parse(v);return Array.isArray(p)?p:[];}catch(e){return v.split(',').map(s=>s.trim()).filter(Boolean);}} return []; }\n\nconst nuevas = parseArr(t.new_signals);\nconst previas = parseArr(t.signals_acumuladas);\nconst setPrevias = new Set(previas);\nconst nuevasUnicas = nuevas.filter(s => !setPrevias.has(s));\n\nlet delta = 0;\nfor (const s of nuevasUnicas) delta += (PESOS[s] || 0);\n\nconst sent = String(t.sentiment || '').toLowerCase();\nif (sent === 'molesto') delta -= 8;\nelse if (sent === 'frustrado') delta -= 4;\n\nconst intent = String(t.intent || '').toLowerCase();\nif (intent === 'spam') delta -= 15;\nelse if (intent === 'fuera_de_alcance') delta -= 5;\n\nconst base = Number(t.current_score || 0);\nlet score = Math.max(0, Math.min(100, base + delta));\n\nconst HOT = 60;\n\nconst hotExpres = nuevas.some(s => HOT_EXPRES.has(s));\nif (hotExpres) score = Math.max(score, HOT);\n\nconst prevMax = Number(t.score_maximo || 0);\nconst score_maximo = Math.max(prevMax, score);\nconst acumuladas = Array.from(new Set([...previas, ...nuevas]));\n\nconst calificado = score >= 40;\nconst cruzo_hotlead = prevMax < HOT && score >= HOT;\n\nlet perfil;\nif (score < 30) perfil = 'Baja prioridad / Nurturing';\nelse if (score < HOT) perfil = 'En proceso';\nelse perfil = 'Caliente / pasar a asesor';\n\n// ── FIX: validar que lead_id sea un record ID real de Airtable ──\nconst rawLeadId = String(t.lead_id || '');\nconst leadId = rawLeadId.startsWith('rec') ? rawLeadId : '';\n\nreturn [{ json: {\n  lead_id: leadId, user_id_canal: t.user_id_canal,\n  lead_score: score, score_maximo, calificado, cruzo_hotlead, perfil,\n  hot_expres: hotExpres,\n  signals_acumuladas: JSON.stringify(acumuladas), delta, senales_nuevas_contadas: nuevasUnicas\n}}];"
      },
