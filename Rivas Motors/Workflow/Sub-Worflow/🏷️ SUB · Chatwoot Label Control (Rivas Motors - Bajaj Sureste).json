    {
      "parameters": {
        "jsCode": "function g(o,path,def=null){ if(!o) return def; return path.split('.').reduce((a,k)=>(a&&a[k]!==undefined&&a[k]!==null)?a[k]:def,o);}\nlet body=$json.body||$json;\nif(typeof body==='string'){ try{ body=JSON.parse(body);}catch(e){} }\n\n// labels: array de strings, array de objetos {title}, o CSV, en varias ubicaciones\nlet labels = body.labels || g(body,'conversation.labels') || g(body,'payload.labels') || g(body,'conversation.additional_attributes.labels') || [];\nif(typeof labels==='string') labels = labels.split(',');\nlabels = (labels||[]).map(l => (typeof l==='string' ? l : (l && (l.title||l.name) || ''))).map(s=>String(s).trim().toLowerCase()).filter(Boolean);\n\n// contact_id (en vez de conv_id)\nconst contact_id = g(body,'contact_inbox.contact_id') || g(body,'meta.sender.id') || g(body,'messages.0.sender.id') || g(body,'sender.id') || null;\n\nlet phone = g(body,'meta.sender.phone_number') || g(body,'conversation.meta.sender.phone_number') || g(body,'meta.sender.identifier') || g(body,'sender.phone_number') || '';\nlet user_id_canal = String(phone||'').replace(/^whatsapp:/i,'').trim();\n\n// Etiquetas reales: 'asesorhumano' (humano) e 'iabajaj' (bot)\nconst tiene_humano = labels.includes('asesorhumano');\nconst tiene_ia = labels.includes('iabajaj');\n\n// Regla: humano manda. asesorhumano => pausar; si no y hay iabajaj => reactivar; si no => ignorar.\nlet accion='ignorar';\nif(!user_id_canal) accion='ignorar';\nelse if(tiene_humano) accion='pausar';\nelse if(tiene_ia) accion='reactivar';\n\nreturn [{ json: { contact_id, user_id_canal, labels, tiene_humano, tiene_ia, accion } }];"
      },
