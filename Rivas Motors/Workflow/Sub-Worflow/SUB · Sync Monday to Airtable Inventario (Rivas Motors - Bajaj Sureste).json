    {
      "parameters": {
        "jsCode": "// Normaliza items de Monday a registros planos para Airtable\nconst items = $input.all();\n\nconst SUCURSAL_MAP = {\n  'BAJAJ MERIDA ORIENTE ESPERANZA': 'MER-OE',\n  'BAJAJ MERIDA CAMPESTRE': 'MER-CAM',\n  'BAJAJ CHETUMAL': 'CHE',\n  'BAJAJ IZAMAL': 'IZA',\n  'BAJAJ MOTUL': 'MOT',\n  'BAJAJ TICUL': 'TIC',\n  'BAJAJ CHAMPOTON': 'CHAM',\n  'BAJAJ CAMPECHE II': 'CAMP2',\n  'BAJAJ ITZAES': 'ITZ',\n  'BAJAJ UMAN': 'UMA',\n  'BAJAJ CAMPECHE': 'CAMP',\n  'BAJAJ PISTE': 'PIS',\n  'BAJAJ CIUDAD DEL CARMEN': 'CDC',\n  'BAJAJ KANASIN': 'KAN'\n};\n\nfunction detectarFamilia(nombre) {\n  if (!nombre) return 'OTRO';\n  const n = nombre.toUpperCase();\n  if (n.includes('AVENGER')) return 'AVENGER';\n  if (n.includes('PULSAR')) return 'PULSAR';\n  if (n.includes('BOXER')) return 'BOXER';\n  if (n.includes('DOMINAR')) return 'DOMINAR';\n  if (n.includes('PLATINA')) return 'PLATINA';\n  return 'OTRO';\n}\n\nfunction detectarCilindrada(nombre, codigo) {\n  if (!nombre) return null;\n  const m1 = nombre.match(/\\b(\\d{2,3})\\b/);\n  if (m1) return parseInt(m1[1], 10);\n  if (codigo) {\n    const m2 = codigo.match(/\\d{3}/);\n    if (m2) return parseInt(m2[0], 10);\n  }\n  return null;\n}\n\nfunction diasDesde(fechaStr) {\n  if (!fechaStr) return null;\n  const d = new Date(fechaStr);\n  if (isNaN(d.getTime())) return null;\n  const hoy = new Date();\n  const diff = (hoy - d) / (1000 * 60 * 60 * 24);\n  return Math.floor(diff);\n}\n\nfunction estadoAntiguedad(dias) {\n  if (dias === null || dias === undefined) return 'Normal';\n  if (dias > 180) return 'Crítico';\n  if (dias > 120) return 'Atención';\n  return 'Normal';\n}\n\nfunction getCol(item, columnTitle) {\n  const cols = item.column_values || [];\n  const col = cols.find(c => c.column && c.column.title === columnTitle);\n  if (!col) return null;\n  return col.text || null;\n}\n\nconst out = [];\nconst nowIso = new Date().toISOString();\n\nfor (const wrapper of items) {\n  const item = wrapper.json;\n  if (!item || !item.id) continue;\n  if (item.state && item.state !== 'active') continue;\n\n  const sucursalNombre = getCol(item, 'Sucursal') || '';\n  const sucursalId = SUCURSAL_MAP[sucursalNombre.toUpperCase()] || 'OTRO';\n  const codigoModelo = getCol(item, 'Codigo de Modelo') || '';\n  const nombreModelo = getCol(item, 'Nombre del Modelo') || '';\n  const fechaIngreso = getCol(item, 'Ingreso') || null;\n  const fechaFab = getCol(item, 'Fecha de fabricación') || null;\n  const cantidadStr = getCol(item, 'ctnd') || '1';\n  const vin = getCol(item, 'No. de serie / VIN') || '';\n  const motor = getCol(item, 'Número de motor') || '';\n  const color = getCol(item, 'Color') || '';\n\n  const dias = diasDesde(fechaIngreso);\n\n  out.push({\n    json: {\n      monday_id: String(item.id),\n      vin_principal: vin,\n      numero_motor: motor,\n      codigo_modelo: codigoModelo,\n      nombre_modelo: nombreModelo,\n      familia_modelo: detectarFamilia(nombreModelo),\n      cilindrada: detectarCilindrada(nombreModelo, codigoModelo),\n      color: color,\n      sucursal_nombre: sucursalNombre,\n      sucursal_id: sucursalId,\n      fecha_ingreso: fechaIngreso,\n      fecha_fabricacion: fechaFab,\n      dias_en_inventario: dias,\n      estado_antiguedad: estadoAntiguedad(dias),\n      cantidad: parseInt(cantidadStr, 10) || 1,\n      ultima_sincronizacion: nowIso\n    }\n  });\n}\n\nreturn out;"
      },
