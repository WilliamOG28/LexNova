      "parameters": {
        "jsCode": "// Decide si saltarse el sync (cache de 2 minutos para evitar spam)\nconst input = $('When Executed by Another Workflow').first().json;\nconst lastSync = $input.first().json.last_sync;\nconst force = input.force_sync === true || input.force_sync === 'true';\n\nconst CACHE_MINUTES = 2;\nconst now = Date.now();\nconst lastSyncMs = lastSync ? parseInt(lastSync) : 0;\nconst minutesSince = (now - lastSyncMs) / 60000;\n\nconst shouldSync = force || !lastSync || minutesSince >= CACHE_MINUTES;\n\nreturn [{\n  json: {\n    should_sync: shouldSync,\n    last_sync_at: lastSync ? new Date(lastSyncMs).toISOString() : null,\n    minutes_since_last: Math.round(minutesSince * 10) / 10,\n    cache_minutes: CACHE_MINUTES,\n    forced: force\n  }\n}];"
      },
