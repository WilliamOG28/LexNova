      "parameters": {
        "jsCode": "const exec = $input.first().json.execution || {};\nconst wf   = $input.first().json.workflow   || {};\nconst err  = exec.error || {};\n\nconst nodoFallido  = err.node?.name || exec.lastNodeExecuted || 'desconocido';\nconst mensajeError = err.message    || 'Sin mensaje de error';\nconst stackTrace   = (err.stack     || '').split('\\n').slice(0, 3).join('\\n');\nconst urlEjecucion = exec.url       || '';\nconst workflowName = wf.name        || 'Workflow desconocido';\nconst workflowId   = wf.id          || '';\nconst timestamp    = new Date().toLocaleString('es-MX', { timeZone: 'America/Merida' });\n\n// Clasifica la severidad segun el nodo que fallo (nodos criticos del MAIN Rivas Motors).\nconst CRITICOS = [\n  'HTTP · Send to Chatwoot',\n  'Agent · Comercial',\n  'Router · Classify Intent',\n  'Switch · Route to Sub-Agent',\n  'Execute · Lead Hydrator',\n  'Execute · Clasificador Origen'\n];\nconst severidad = CRITICOS.includes(nodoFallido) ? '🔴 CRÍTICO' : '🟡 ADVERTENCIA';\n\nreturn [{\n  json: {\n    severidad,\n    workflow_name: workflowName,\n    workflow_id:   workflowId,\n    nodo_fallido:  nodoFallido,\n    mensaje_error: mensajeError,\n    stack_trace:   stackTrace,\n    url_ejecucion: urlEjecucion,\n    timestamp\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -16
      ],
      "id": "21d4e0e1-586f-4c56-84d3-40b1032541fb",
