    {
      "parameters": {
        "jsCode": "// Construye el mensaje de novedades segun el numero de ciclo ya enviado.\nconst f = $json.fields || $json;\nconst nombre = (f.nombre || '').split(' ')[0] || 'Hola';\nconst ciclo = Number(f.followups_count || 0); // ciclos ya enviados\nconst modelo = f.modelo_interes || '';\n\n// Rotacion de mensajes de reenganche (novedades, NO presion).\nconst MENSAJES = [\n  `Hola ${nombre}, te saluda Rivas Motors (Bajaj). Seguimos con buena disponibilidad${modelo ? ' en la ' + modelo : ' en varios modelos'} y planes a crédito. ¿Te gustaría que te pase los detalles?`,\n  `¡Hola ${nombre}! Pasando a saludarte de Rivas Motors. Tenemos promociones vigentes y unidades listas para entrega${modelo ? ' como la ' + modelo : ''}. ¿Retomamos cuando te quede bien?`,\n  `Hola ${nombre}, ¿cómo vas? Te escribo de Rivas Motors por si quieres que te comparta opciones de financiamiento y disponibilidad actual. Sin compromiso, cuando gustes.`\n];\nconst idx = ciclo % MENSAJES.length;\nconst mensaje = MENSAJES[idx];\n\nconst now = new Date();\nconst next = new Date(now.getTime() + 14 * 24 * 3600 * 1000);\n\nreturn [{\n  json: {\n    lead_id: $json.id,\n    user_id_canal: f.user_id_canal,\n    conversation_id: f.conversation_id,\n    mensaje,\n    nuevo_ciclo: ciclo + 1,\n    next_followup_at: next.toISOString(),\n    last_followup_sent_at: now.toISOString()\n  }\n}];"
      },
