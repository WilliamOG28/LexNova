      "parameters": {
        "jsCode": "// Ventana horaria de envio: 9-21 hora de Merida (UTC-6 fijo).\n// Evita mandar mensajes de reenganche de madrugada.\nconst now = new Date();\nconst merida = new Date(now.getTime() - 6 * 3600 * 1000);\nconst hour = merida.getUTCHours();\nconst dow  = merida.getUTCDay(); // 0=Dom\nconst dentro_ventana = hour >= 9 && hour < 21 && dow !== 0; // no domingos\nreturn [{ json: { dentro_ventana, hora_merida: hour } }];"
      },
