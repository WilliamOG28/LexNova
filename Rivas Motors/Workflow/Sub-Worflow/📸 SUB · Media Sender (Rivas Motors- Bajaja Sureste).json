        "jsCode": "\nfunction F(r){ return (r && r.fields && typeof r.fields==='object') ? r.fields : (r||{}); }\nconst t = $('When Executed by Another Workflow').first().json;\nconst tipo = (t.tipo || 'imagenes');\nconst conv = t.conversation_id;\nconst modelo = t.modelo || '';\nconst nombre = t.nombre || '';\n\nlet atts = [];\nlet link = '';\nlet entidad = modelo; // por defecto, la entidad es el modelo\ntry {\n  if (tipo === 'imagenes') {\n    const r = F($('Airtable · Get Model Images1').first().json);\n    atts = r.kit_imagenes || [];\n  } else if (tipo === 'ficha') {\n    const r = F($('Airtable · Get Model Images1').first().json);\n    atts = r.ficha_tecnica_pdf || [];\n  } else if (tipo === 'promo') {\n    const r = F($('Airtable · Get Promo1').first().json);\n    atts = (r.imagen && r.imagen.length ? r.imagen : (r.pdf || []));\n  } else if (tipo === 'accesorios') {\n    const r = F($('Airtable · Get Config1').first().json);\n    atts = r.accesorios_pdf || [];\n    link = r.accesorios_link || '';\n  } else if (tipo === 'financiera') {\n    const r = F($('Airtable · Get Financiera Flyer').first().json);\n    atts = r.flyer || [];\n    entidad = r.nombre || nombre;\n  }\n} catch (e) {}\n\nconst imgs = (Array.isArray(atts) ? atts : []).filter(a => a && a.url);\n\n// Sin attachments: NUNCA decir al cliente que no hay material.\nif (imgs.length === 0) {\n  const msg = link\n    ? ('Comparte este enlace con el cliente de forma natural (sin decir que no tienes otra cosa): ' + link)\n    : 'No había material para enviar. Continúa la conversación con normalidad (describe el modelo, avanza o agenda). NO le digas al cliente que no tienes fotos, ficha, flyer ni material.';\n  return [{ json: { sin_assets: true, ok: !!link, conversation_id: conv, modelo, nombre, tipo, link: link || '', mensaje_agente: msg } }];\n}\n\nreturn imgs.map((a, i) => ({ json: {\n  sin_assets: false,\n  url: a.url,\n  filename: a.filename || (entidad + '_' + tipo + '_' + (i+1) + (tipo==='imagenes' || tipo==='financiera' || tipo==='promo' ? '.jpg' : '.pdf')),\n  conversation_id: conv, modelo, nombre, tipo, link: link || '',\n  idx: i+1, total: imgs.length\n}}));\n"
      },
