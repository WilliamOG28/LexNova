      "parameters": {
        "jsCode": "// Decide los campos de reactivacion segun la etapa actual del lead.\nfunction F(r){ return (r && r.fields && typeof r.fields==='object') ? r.fields : (r||{}); }\nlet rec = {};\ntry { rec = $('Airtable · Search Lead').first().json; } catch(e){}\nconst f = F(rec);\nconst etapa = f.etapa_pipeline || '';\nconst userId = f.user_id_canal || $('Code · Parse Status Event').first().json.phone || '';\nconst leadId = rec.id || null;\n\nconst cerrado_o_perdido = (etapa === 'Cerrado (venta)' || etapa === 'Perdido');\n\nconst now = new Date();\nconst next = new Date(now.getTime() + 14*24*3600*1000);\n\n// Si esta cerrado/perdido: reactivamos el bot pero NO tocamos la etapa ni reprogramamos nurturing.\nconst nueva_etapa = cerrado_o_perdido ? etapa : 'En seguimiento manual por reenganche';\n\nreturn [{ json: {\n  lead_id: leadId,\n  user_id_canal: userId,\n  nueva_etapa,\n  next_followup_at: next.toISOString(),\n  reactivado: true\n}}];"
      },
