    {
      "parameters": {
        "jsCode": "// Parsea el evento conversation_status_changed de Chatwoot.\nfunction g(o, path, def = null) {\n  if (!o) return def;\n  return path.split('.').reduce((a, k) =>\n    (a && a[k] !== undefined && a[k] !== null) ? a[k] : def, o);\n}\n\nlet body = $json.body || $json;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) {} }\n\nconst event  = body.event || '';\nconst status = (body.status || g(body,'conversation.status') || '').toLowerCase();\n\nconst conv_id =\n    body.id || body.display_id ||\n    g(body,'conversation.id') || g(body,'conversation.display_id') || null;\n\nconst inbox_id =\n    body.inbox_id || g(body,'conversation.inbox_id') || g(body,'contact_inbox.inbox_id') || null;\n\nconst contact_id =\n    g(body,'contact_inbox.contact_id') || g(body,'meta.sender.id') || g(body,'messages.0.sender.id') || null;\n\nlet phone =\n    g(body,'meta.sender.phone_number') ||\n    g(body,'conversation.meta.sender.phone_number') ||\n    g(body,'meta.sender.identifier') || '';\nphone = String(phone||'').replace(/^whatsapp:/i,'').trim();\n\nconst es_resolved = event === 'conversation_status_changed' && status === 'resolved';\n\nreturn [{ json: { event, status, conv_id, inbox_id, contact_id, phone, es_resolved } }];"
      },
