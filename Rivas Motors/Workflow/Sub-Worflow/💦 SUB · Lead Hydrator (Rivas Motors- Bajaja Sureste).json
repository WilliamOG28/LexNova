      "parameters": {
        "jsCode": "// Merge final: combina el lead (que viaja en el flujo desde el Set) con las financieras\n// El lead viene del nodo Redis · Save Lead Cache upstream (que preserva todo el payload).\n// Las financieras vienen del Code · Parse Cached Financieras o del Code · Format Financieras.\n\nconst leadNode = $('Redis · Save Lead Cache1').first().json;\nconst finsCurrent = $json;\n\n// El lead node puede o no traer todos los campos - los tomamos del Set upstream\n// que a su vez es el output del Redis · Get Lead Cache o de los Sets Found/Not Found.\n\n// Buscar el output \"canónico\" del lead - viene del Set · Lead Found o Set · Lead Not Found o Code · Parse Cached Lead\nlet lead = {};\ntry { lead = $('Set · Lead Found').first().json; } catch(e) {}\nif (!lead || !Object.keys(lead).length) {\n  try { lead = $('Set · Lead Not Found').first().json; } catch(e) {}\n}\nif (!lead || !Object.keys(lead).length) {\n  try { lead = $('Code · Parse Cached Lead1').first().json; } catch(e) {}\n}\n\nreturn [{ json: {\n  ...lead,\n  financieras_disponibles: finsCurrent.financieras_disponibles || [],\n  _financieras_from_cache: !!finsCurrent._financieras_from_cache\n} }];"
      },
