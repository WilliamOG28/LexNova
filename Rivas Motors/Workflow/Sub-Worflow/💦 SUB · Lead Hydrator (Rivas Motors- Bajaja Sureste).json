    {
      "parameters": {
        "jsCode": "// Formatear el output de Airtable en un array digestible por el agente\nfunction F(r){ return (r && r.fields && typeof r.fields==='object') ? r.fields : (r||{}); }\n\nconst items = $input.all();\nconst financieras_disponibles = items\n  .map(it => {\n    const f = F(it.json);\n    return {\n      nombre: f.nombre || '',\n      nombre_corto: f.nombre_corto || f.nombre || '',\n      orden: Number(f.orden) || 99,\n      descripcion_agente: f.descripcion_agente || '',\n      ventajas_clave: f.ventajas_clave || '',\n      requisitos_resumen: f.requisitos_resumen || '',\n      plazos_disponibles: f.plazos_disponibles || '',\n      plazos_valores: f.plazos_valores || '',\n      enganche_minimo_pct: Number(f.enganche_minimo_pct) || null,\n      flyer_disponible: Array.isArray(f.flyer) && f.flyer.length > 0\n    };\n  })\n  .filter(f => f.nombre)\n  .sort((a,b) => a.orden - b.orden);\n\nreturn [{ json: { financieras_disponibles, _financieras_from_cache: false } }];"
      },
