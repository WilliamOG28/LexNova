      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "\n// ── Normaliza el telefono y arma TODAS las llaves de Redis del lead ────────\n// Se aceptan formatos sueltos: \"9996167830\", \"+5219996167830\", \"521 999 616 7830\".\n// Como en Chatwoot el user_id_canal puede venir con o sin +52 / 521, se generan\n// las variantes y se borran todas: borrar una llave inexistente no cuesta nada.\nconst trig = $('When Executed by Another Workflow').first().json;\nconst raw  = String(trig.user_id_canal || '+529996167830').trim();\nif (!raw) throw new Error('Falta user_id_canal');\n\nconst digits = raw.replace(/\\D/g, '');\nconst d10 = digits.slice(-10);                       // 9996167830\n\nconst ids = new Set([\n  raw,\n  digits,\n  d10,\n  '+' + digits,\n  '52'  + d10,  '+52'  + d10,\n  '521' + d10,  '+521' + d10,\n]);\n\n// Prefijos por-lead que usa el sistema. NO se tocan llaves globales\n// (financieras:activas) ni contadores de round-robin por sucursal (rr:asesor:*),\n// porque son compartidos entre todos los leads.\nconst PREFIJOS = ['lead:', 'buffer:', 'pause:', 'mirror:lead:'];\n\nconst keys = [];\nfor (const id of ids) {\n  if (!id) continue;\n  for (const p of PREFIJOS) keys.push(p + id);\n}\n\nconst unicas = [...new Set(keys)];\nreturn unicas.map(k => ({ json: {\n  key: k,\n  user_id_canal: raw,\n  telefono_10: d10,\n  total_keys: unicas.length,\n} }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        112
      ],
      "id": "6cd26f41-d097-41ff-8f98-faf16b9b4946",
      "name": "Code · Armar Llaves"
