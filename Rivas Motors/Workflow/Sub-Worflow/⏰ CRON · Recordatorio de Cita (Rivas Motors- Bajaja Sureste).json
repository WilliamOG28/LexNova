    {
      "parameters": {
        "jsCode": "\nfunction F(r){ return (r && r.fields && typeof r.fields === 'object') ? r.fields : (r || {}); }\n\nconst cita = $('Loop · Por Cita').item.json;\nconst f = F(cita);\n\nlet lead = {};   try { lead = F($('Airtable · Get Lead').first().json); } catch(e) {}\nlet asesor = {}; try { asesor = F($('Airtable · Get Asesor Cita').first().json); } catch(e) {}\nlet S = {};      try { S = F($('Airtable · Get Sucursal Cita').first().json); } catch(e) {}\n\nconst slackId = String(asesor.slack_id || '').trim();\nconst has_slack = !!slackId && !slackId.startsWith('REEMPLAZA');\n\nconst cliente = lead.nombre || f.user_id_canal || 'Cliente';\nconst tel     = f.user_id_canal || lead.telefono || '';\nconst telWa   = String(tel).replace(/[^0-9]/g, '');\nconst tipo    = f.tipo_cita || 'Cita';\nconst modelo  = f.modelo_interes ? ` · ${f.modelo_interes}` : '';\nconst fechaTxt = new Date(f.fecha_hora_inicio).toLocaleString('es-MX',\n  { timeZone:'America/Merida', weekday:'long', day:'numeric', month:'long',\n    hour:'2-digit', minute:'2-digit', hour12:true });\n\n// Perfil: solo los campos con valor, para que el asesor llegue con contexto.\nconst money = (n) => (n != null && n !== '' && !isNaN(Number(n)))\n  ? '$' + Number(n).toLocaleString('en-US') : null;\nconst rows = [];\nconst push = (k, v) => { if (v != null && String(v).trim() !== '') rows.push(`*${k}:* ${v}`); };\npush('Ciudad', lead.ciudad);\npush('Uso', lead.uso_principal);\npush('Forma de pago', lead.forma_pago_preferida);\npush('Enganche', money(lead.enganche_disponible));\npush('Presupuesto', money(lead.presupuesto_declarado));\npush('Financiera', lead.financiera_elegida);\npush('Temperatura', lead.temperatura);\nconst perfil = rows.length ? rows.join('\\n') : '';\n\nconst chatUrl = lead.conversation_id\n  ? `https://cwrivasmotors.lexnova.cloud/app/accounts/1/conversations/${lead.conversation_id}`\n  : '';\n\nconst slack_text = [\n  ':calendar: *Recordatorio: tienes una cita mañana*',\n  `*${tipo}*${modelo} · ${fechaTxt}`,\n  S.nombre ? `*Sucursal:* ${S.nombre}${S.direccion ? ' — ' + S.direccion : ''}` : '',\n  '',\n  `*Cliente:* ${cliente}`,\n  telWa ? `*WhatsApp:* <https://wa.me/${telWa}|${tel}>` : '',\n  perfil,\n  f.notas ? `*Notas:* ${f.notas}` : '',\n  chatUrl ? `:link: <${chatUrl}|Abrir chat en Chatwoot>` : '',\n  '',\n  '_Ya le mandamos el recordatorio al cliente por WhatsApp._',\n].filter(x => x !== '').join('\\n');\n\nreturn [{ json: { has_slack, slack_channel: slackId, slack_text } }];\n"
      },
