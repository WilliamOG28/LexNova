      "parameters": {
        "jsCode": "\nfunction F(r){ return (r && r.fields && typeof r.fields === 'object') ? r.fields : (r || {}); }\n\nconst cita = $('Loop · Por Cita').item.json;\nconst f = F(cita);\n\nlet lead = {};\ntry { lead = F($('Airtable · Get Lead').first().json); } catch(e) {}\n\nlet S = {};\ntry { S = F($('Airtable · Get Sucursal Cita').first().json); } catch(e) {}\n\nconst conversation_id = lead.conversation_id || '';\nconst nombre  = String(lead.nombre || '').split(' ')[0] || '';\nconst tipo    = String(f.tipo_cita || 'tu cita').toLowerCase();\nconst modelo  = f.modelo_interes ? ` (${f.modelo_interes})` : '';\nconst fechaTxt = new Date(f.fecha_hora_inicio).toLocaleString('es-MX',\n  { timeZone:'America/Merida', weekday:'long', day:'numeric', month:'long',\n    hour:'2-digit', minute:'2-digit', hour12:true });\n\n// Burbujas: cada bloque separado por línea en blanco es un mensaje aparte.\n// Solo se incluye lo que exista, para no mandar frases a medias.\nconst saludo = nombre ? `Hola ${nombre}, ` : 'Hola, ';\nconst b1 = `${saludo}te recuerdo tu ${tipo}${modelo} de mañana ${fechaTxt}.`;\n\nconst donde = [];\nif (S.nombre)    donde.push(`Es en ${S.nombre}`);\nif (S.direccion) donde.push(S.direccion);\nconst b2 = donde.length ? donde.join(', ') + '.' : '';\n\nconst b3 = S.google_maps ? `Aquí te dejo la ubicación: ${S.google_maps}` : '';\nconst b4 = '¿Nos confirmas que asistes? Si necesitas moverla, con gusto la reagendamos 🙌';\n\nconst mensaje = [b1, b2, b3, b4].filter(Boolean).join('\\n\\n');\n\nreturn [{ json: {\n  conversation_id,\n  tiene_conversacion: !!String(conversation_id).trim(),\n  mensaje,\n  cita_rec: cita.id,\n  sucursal_nombre: S.nombre || '',\n  sucursal_direccion: S.direccion || '',\n  fecha_legible: fechaTxt,\n} }];\n"
      },
