      "parameters": {
        "jsCode": "\n// Una sola ventana para los dos modos. `dias` escala el rango y sirve\n// después para sacar el promedio diario del reporte semanal.\nconst modo = String($json.modo || 'diario').toLowerCase();\nconst dias = (modo === 'semanal') ? 7 : 1;\n\nconst now   = new Date();\nconst start = new Date(now.getTime() - dias * 24 * 3600 * 1000);\n\nconst fmt = (dt) => dt.toLocaleDateString('es-MX',\n  { timeZone:'America/Merida', weekday:'long', day:'numeric', month:'long' });\n\n// Rango de MAÑANA en hora MX (-06:00), para las citas del día siguiente.\nconst mx = new Date(now.getTime() - 6*3600000);\nconst t  = new Date(Date.UTC(mx.getUTCFullYear(), mx.getUTCMonth(), mx.getUTCDate()+1, 0,0,0));\nconst y = t.getUTCFullYear(), m = String(t.getUTCMonth()+1).padStart(2,'0'), dd = String(t.getUTCDate()).padStart(2,'0');\n\nreturn [{ json: {\n  modo, dias,\n  start_iso: start.toISOString(),\n  end_iso:   now.toISOString(),\n  fecha_legible: fmt(now),\n  rango_legible: (modo === 'semanal') ? `${fmt(start)} — ${fmt(now)}` : fmt(now),\n  manana_start: `${y}-${m}-${dd}T00:00:00-06:00`,\n  manana_end:   `${y}-${m}-${dd}T23:59:59-06:00`,\n} }];\n"
      },
