    {
      "parameters": {
        "jsCode": "\n// ── Resumen Rivas Motors · diario o semanal ───────────────────────────────\nfunction F(rec){ return (rec && rec.fields && typeof rec.fields === 'object') ? rec.fields : (rec || {}); }\nfunction rows(nodeName){\n  try { return $(nodeName).all().filter(x => x.json && x.json.id).map(x => ({ id: x.json.id, ...F(x.json) })); }\n  catch(e) { return []; }\n}\nconst one = (v) => Array.isArray(v) ? (v[0] || null) : (v || null);\nconst pct = (a, b) => b > 0 ? Math.round((a / b) * 100) : 0;\n\nconst V = $('Code · Ventana').first().json;\nconst esSemanal = V.modo === 'semanal';\n\n// ── Catálogos ────────────────────────────────────────────────────────────\nconst sucs = rows('Airtable · Sucursales (map)');\nconst sucNombre = {}, sucCodigo = {};\nsucs.forEach(s => { sucNombre[s.id] = s.nombre || s.sucursal_id || '—'; sucCodigo[s.id] = s.sucursal_id || ''; });\n\nconst asesores = rows('Airtable · Asesores (map)');\nconst aseNombre = {}, aseSuc = {};\nasesores.forEach(a => { aseNombre[a.id] = a.nombre || a.asesor_id || '—'; aseSuc[a.id] = one(a.sucursal); });\n\n// ── Datos de la ventana ──────────────────────────────────────────────────\nconst leadsNuevos = rows('Airtable · Leads Nuevos 24h');\nconst citas       = rows('Airtable · Citas 24h');\nconst nurturing   = rows('Airtable · Nurturing 24h');\nconst asignados   = rows('Airtable · Asignados 24h');\nconst calificados = rows('Airtable · Calificados (snapshot)');\nconst hotSin      = rows('Airtable · Hot Sin Atender');\nconst citasMan    = rows('Airtable · Citas Mañana');\n\n// ── Acumulador por sucursal y por asesor ─────────────────────────────────\nconst SUC = {}, ASE = {};\nconst NUEVO = () => ({ nuevos:0, asignados:0, citas:0, hot:0, calificados:0, nurturing:0, citas_manana:0 });\nconst bumpSuc = (recId, k, n) => {\n  const key = recId || '__sin__';\n  (SUC[key] = SUC[key] || NUEVO())[k] += (n || 1);\n};\nconst bumpAse = (recId, k, n) => {\n  if (!recId) return;\n  (ASE[recId] = ASE[recId] || NUEVO())[k] += (n || 1);\n};\n\nleadsNuevos.forEach(l => { bumpSuc(one(l.sucursal_interes), 'nuevos'); bumpAse(one(l.asesor_asignado), 'nuevos'); });\nasignados.forEach(l   => { bumpSuc(one(l.sucursal_interes), 'asignados'); bumpAse(one(l.asesor_asignado), 'asignados'); });\ncitas.forEach(c       => { bumpSuc(one(c.sucursal), 'citas'); bumpAse(one(c.asesor), 'citas'); });\ncitasMan.forEach(c    => { bumpSuc(one(c.sucursal), 'citas_manana'); bumpAse(one(c.asesor), 'citas_manana'); });\nnurturing.forEach(l   => { bumpSuc(one(l.sucursal_interes), 'nurturing'); });\ncalificados.forEach(l => { bumpSuc(one(l.sucursal_interes), 'calificados'); bumpAse(one(l.asesor_asignado), 'calificados'); });\nhotSin.forEach(l      => { bumpSuc(one(l.sucursal_interes), 'hot'); bumpAse(one(l.asesor_asignado), 'hot'); });\n\n// ── Globales ─────────────────────────────────────────────────────────────\nconst gNuevos = leadsNuevos.length, gCitas = citas.length, gAsig = asignados.length;\nconst gNurt = nurturing.length, gCalif = calificados.length, gHot = hotSin.length;\nconst tasaCita = pct(gCitas, gNuevos);\nconst promDia  = (n) => esSemanal ? ` (${(n / (V.dias || 7)).toFixed(1)}/día)` : '';\n\n// Citas por estado y por tipo\nconst porEstado = {}, porTipo = {};\ncitas.forEach(c => {\n  const e = c.estado || 'Sin estado'; porEstado[e] = (porEstado[e] || 0) + 1;\n  const t = c.tipo_cita || 'Sin tipo'; porTipo[t] = (porTipo[t] || 0) + 1;\n});\nconst listaPares = (o) => Object.keys(o).sort((a,b) => o[b]-o[a]).map(k => `${k}: *${o[k]}*`).join('  ·  ') || '_ninguna_';\n\n// ── Bloque por sucursal ──────────────────────────────────────────────────\nconst filasSuc = Object.keys(SUC)\n  .map(id => ({ id, nom: id === '__sin__' ? '⚠️ Sin sucursal' : (sucNombre[id] || '—'), ...SUC[id] }))\n  .filter(s => s.nuevos || s.asignados || s.citas || s.hot || s.citas_manana)\n  .sort((a,b) => (b.nuevos + b.citas) - (a.nuevos + a.citas));\n\nconst bloqueSuc = filasSuc.length ? filasSuc.map(s => {\n  const partes = [];\n  if (s.nuevos)       partes.push(`${s.nuevos} nuevos`);\n  if (s.citas)        partes.push(`${s.citas} citas`);\n  if (s.calificados)  partes.push(`${s.calificados} calificados`);\n  if (s.hot)          partes.push(`:fire: ${s.hot} sin atender`);\n  if (s.citas_manana) partes.push(`:calendar: ${s.citas_manana} mañana`);\n  return `• *${s.nom}* — ${partes.join(' · ') || 'sin movimiento'}`;\n}).join('\\n') : '_sin movimiento en el periodo_';\n\n// ── Bloque por asesor (agrupado bajo su sucursal) ────────────────────────\nconst porSucAse = {};\nObject.keys(ASE).forEach(id => {\n  const s = aseSuc[id] || '__sin__';\n  (porSucAse[s] = porSucAse[s] || []).push({ id, nom: aseNombre[id] || '—', ...ASE[id] });\n});\nconst bloqueAse = Object.keys(porSucAse).sort((a,b) =>\n    String(sucNombre[a]||'zz').localeCompare(String(sucNombre[b]||'zz'))\n  ).map(sid => {\n    const lista = porSucAse[sid]\n      .sort((a,b) => (b.asignados + b.citas) - (a.asignados + a.citas))\n      .map(a => {\n        const p = [];\n        if (a.asignados)    p.push(`${a.asignados} asignados`);\n        if (a.citas)        p.push(`${a.citas} citas`);\n        if (a.hot)          p.push(`:fire: ${a.hot}`);\n        if (a.citas_manana) p.push(`:calendar: ${a.citas_manana} mañana`);\n        return `   • ${a.nom} — ${p.join(' · ') || 'sin actividad'}`;\n      }).join('\\n');\n    return `*${sid === '__sin__' ? '⚠️ Sin sucursal' : (sucNombre[sid] || '—')}*\\n${lista}`;\n  }).join('\\n\\n');\n\n// ── Hot sin atender: los 10 más calientes ────────────────────────────────\nconst hotTop = hotSin\n  .map(l => ({ n: l.nombre || l.user_id_canal || '—', s: Number(l.lead_score || 0),\n               suc: sucNombre[one(l.sucursal_interes)] || 's/suc' }))\n  .sort((a,b) => b.s - a.s);\nconst hotTxt = hotTop.length\n  ? hotTop.slice(0,10).map(h => `   • ${h.n} — score ${h.s} · ${h.suc}`).join('\\n')\n    + (hotTop.length > 10 ? `\\n   • …y ${hotTop.length - 10} más` : '')\n  : '_ninguno_ :tada:';\n\n// ── Mensaje 1: general + por sucursal ────────────────────────────────────\nconst titulo = esSemanal\n  ? `:calendar: *Resumen SEMANAL — Rivas Motors*\\n_${V.rango_legible}_`\n  : `:bar_chart: *Resumen diario — Rivas Motors*\\n_${V.fecha_legible}_`;\n\nconst texto =\n`${titulo}\n\n*— General —*\n• Leads nuevos: *${gNuevos}*${promDia(gNuevos)}\n• Leads asignados a asesor: *${gAsig}*\n• Citas agendadas: *${gCitas}*${promDia(gCitas)}  ·  conversión lead→cita: *${tasaCita}%*\n• Toques de nurturing: *${gNurt}*\n• Citas por estado — ${listaPares(porEstado)}\n• Citas por tipo — ${listaPares(porTipo)}\n\n*— Por sucursal —*\n${bloqueSuc}\n\n*— Hot leads sin atender (score ≥ 60): ${hotTop.length} —*\n${hotTxt}\n\n_Snapshot actual_\n• Leads calificados: *${gCalif}*  ·  Hot leads: *${gHot}*  ·  Citas mañana: *${citasMan.length}*`;\n\n// ── Mensaje 2: desglose por asesor ───────────────────────────────────────\nconst texto_asesores = bloqueAse\n  ? `${esSemanal ? ':busts_in_silhouette: *Desglose semanal por asesor*' : ':busts_in_silhouette: *Desglose por asesor*'}\\n\\n${bloqueAse}`\n  : '';\n\nreturn [{ json: {\n  modo: V.modo, texto, texto_asesores,\n  hay_detalle: !!texto_asesores,\n  leadsNuevos: gNuevos, asignados: gAsig, citas: gCitas, nurturing: gNurt,\n  calificados: gCalif, hot: gHot, tasa_cita: tasaCita,\n  sucursales_con_movimiento: filasSuc.length, asesores_con_actividad: Object.keys(ASE).length,\n} }];\n"
      },
