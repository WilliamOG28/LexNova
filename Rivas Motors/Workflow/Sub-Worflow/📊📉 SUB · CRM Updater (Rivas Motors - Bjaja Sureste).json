    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst campo = String(input.campo || '').trim().toLowerCase();\nconst valor = input.valor;\nconst userId = input.user_id_canal;\nconst sucursal = input.sucursal_id;\n\n// FIELD_MAP — Rivas Motors (giro motos). El bot SÍ captura enganche (parte de calificar a crédito).\nconst CAMPOS = {\n  nombre:           { col: 'nombre',                tipo: 'string' },\n  ciudad:           { col: 'ciudad',                tipo: 'string' },\n  ciudad_origen:    { col: 'ciudad',                tipo: 'string' },\n  email:            { col: 'email',                 tipo: 'string' },\n  telefono:         { col: 'telefono',              tipo: 'string' },\n  colonia:          { col: 'colonia',               tipo: 'string' },\n  presupuesto:      { col: 'presupuesto_declarado', tipo: 'number' },\n  enganche:         { col: 'enganche_disponible',   tipo: 'number' },\n  modelo_interes:   { col: 'modelo_interes',        tipo: 'string' },\n  categoria_interes:{ col: 'categoria_interes',     tipo: 'select_categoria' },\n  uso_principal:    { col: 'uso_principal',         tipo: 'select_uso' },\n  forma_pago:       { col: 'forma_pago_preferida',  tipo: 'select_pago' },\n  como_conocio:     { col: 'como_conocio',          tipo: 'select_canal' },\n  financiera_elegida:{ col: 'financiera_elegida',   tipo: 'string' },\n  objecion:         { col: 'objeciones_detectadas', tipo: 'string' },\n  lead_summary:     { col: 'lead_summary',          tipo: 'string' },\n  ultima_intencion: { col: 'ultima_intencion',      tipo: 'string' },\n  // La sucursal es link, no texto: se resuelve al recId vivo en el nodo siguiente.\n  sucursal:         { col: '__SUCURSAL__',          tipo: 'sucursal' },\n  sucursal_elegida: { col: '__SUCURSAL__',          tipo: 'sucursal' },\n};\n\n// Normalizacion de single-selects (valores reales de la base RM)\nconst MAP_CATEGORIA = {\n  'utilitaria':'Utilitaria / trabajo','trabajo':'Utilitaria / trabajo','de trabajo':'Utilitaria / trabajo','carga':'Utilitaria / trabajo',\n  'scooter':'Scooter','automatica':'Scooter','automática':'Scooter',\n  'urbana':'Urbana','ciudad':'Urbana',\n  'doble proposito':'Doble propósito','doble propósito':'Doble propósito','aventura':'Doble propósito','todo terreno':'Doble propósito',\n  'deportiva':'Deportiva','deportivo':'Deportiva','pistera':'Deportiva',\n};\nconst MAP_USO = {\n  'trabajo':'Trabajo / reparto','reparto':'Trabajo / reparto','repartidor':'Trabajo / reparto','delivery':'Trabajo / reparto','reparti':'Trabajo / reparto',\n  'personal':'Transporte personal','transporte':'Transporte personal','transportarme':'Transporte personal','moverme':'Transporte personal','ir al trabajo':'Transporte personal',\n  'gusto':'Gusto / deportivo','hobby':'Gusto / deportivo','pasear':'Gusto / deportivo','deportivo':'Gusto / deportivo',\n};\nconst MAP_PAGO = {\n  'contado':'Contado','de contado':'Contado','efectivo':'Contado','pago completo':'Contado',\n  'credito':'Crédito / financiamiento','crédito':'Crédito / financiamiento','financiamiento':'Crédito / financiamiento','financiar':'Crédito / financiamiento','a meses':'Crédito / financiamiento','mensualidades':'Crédito / financiamiento','enganche':'Crédito / financiamiento',\n};\nconst MAP_CANAL = {\n  'recomendacion':'Recomendación','recomendación':'Recomendación','referido':'Recomendación','un amigo':'Recomendación','me recomendaron':'Recomendación',\n  'redes':'Redes sociales','facebook':'Redes sociales','instagram':'Redes sociales','tiktok':'Redes sociales','fb':'Redes sociales','ig':'Redes sociales',\n  'publicidad':'Publicidad','anuncio':'Publicidad','espectacular':'Publicidad','radio':'Publicidad','lona':'Publicidad',\n  'paso por sucursal':'Paso por sucursal','pase':'Paso por sucursal','vi la tienda':'Paso por sucursal','sucursal':'Paso por sucursal',\n  'google':'Internet/Google','internet':'Internet/Google','busque':'Internet/Google','busqué':'Internet/Google','pagina web':'Internet/Google','página web':'Internet/Google',\n};\n\nconst def = CAMPOS[campo];\nif (!def) {\n  return [{ json: { ok: false, error: `Campo no permitido: ${campo}`, user_id_canal: userId } }];\n}\n\nlet valorFinal = valor;\nconst v = String(valor || '').trim().toLowerCase();\n\nif (def.tipo === 'number') {\n  let raw = String(valor || '').toLowerCase().trim();\n  const tieneMiles = /\\bmil\\b/.test(raw) || /\\d+\\s*k\\b/.test(raw);\n  let limpio = raw.replace(/[^0-9.]/g, '');\n  let n = Number(limpio);\n  if (tieneMiles && !isNaN(n) && n < 1000) { n = n * 1000; }\n  valorFinal = isNaN(n) ? null : n;\n} else if (def.tipo === 'string') {\n  valorFinal = String(valor || '').trim().slice(0, 1000);\n} else if (def.tipo === 'select_categoria') {\n  valorFinal = MAP_CATEGORIA[v] || 'Otro';\n} else if (def.tipo === 'select_uso') {\n  valorFinal = MAP_USO[v] || 'Aún no sabe';\n} else if (def.tipo === 'select_pago') {\n  valorFinal = MAP_PAGO[v] || 'Aún no sabe';\n} else if (def.tipo === 'select_canal') {\n  valorFinal = MAP_CANAL[v] || 'Otro';\n} else if (def.tipo === 'sucursal') {\n  // El valor puede venir como codigo (ITZ) o como nombre (Itzaes / Bajaj Itzaes).\n  valorFinal = String(valor || '').trim();\n}\n\nif (valorFinal === null || valorFinal === '') {\n  return [{ json: { ok: false, error: 'Valor vacio tras limpieza', user_id_canal: userId } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    user_id_canal: userId,\n    campo_original: campo,\n    columna_airtable: def.col,\n    valor_final: valorFinal,\n    tipo: def.tipo,\n    sucursal: sucursal,\n    // clave para resolver la sucursal: el parametro sucursal_id, o el valor si campo=sucursal\n    sucursal_clave: (def.tipo === 'sucursal' ? valorFinal : '') || sucursal || '',\n  }\n}];"
      },
