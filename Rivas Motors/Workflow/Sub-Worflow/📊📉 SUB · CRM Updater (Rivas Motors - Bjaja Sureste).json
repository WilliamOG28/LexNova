    {
      "parameters": {
        "jsCode": "\nconst input = $('Code · Validate & Map1').first().json;\n\n// Escribe SOLO el campo que llega + ultima_interaccion (+ la sucursal si viene).\n// `sucursal_interes` es un LINK: hay que mandar el recId VIVO en array, nunca texto\n// ni un recId cacheado (gotcha #3). Por eso se resuelve aqui contra el catalogo.\nfunction F(r){ return (r && r.fields && typeof r.fields==='object') ? r.fields : (r||{}); }\nfunction norm(s){ return String(s||'').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').trim(); }\n\nlet sucs=[];\ntry { sucs = $('Airtable · Get Sucursales').all().map(i=>i.json).filter(r=>r&&r.id).map(r=>({id:r.id, ...F(r)})); } catch(e){}\n\nconst clave = norm(input.sucursal_clave);\nlet sucRec = null;\nif (clave) {\n  sucRec = sucs.find(s => norm(s.sucursal_id) === clave) || null;                 // 1. codigo exacto\n  if (!sucRec) sucRec = sucs.find(s => norm(s.nombre) === clave) || null;         // 2. nombre exacto\n  if (!sucRec && clave.length >= 4) {                                             // 3. nombre parcial,\n    const p = sucs.filter(s => norm(s.nombre).includes(clave));                   //    solo si es UNICO\n    if (p.length === 1) sucRec = p[0];\n  }\n}\n\nconst out = {\n  user_id_canal:      input.user_id_canal,\n  ultima_interaccion: new Date().toISOString(),\n};\nif (input.columna_airtable && input.columna_airtable !== '__SUCURSAL__') {\n  out[input.columna_airtable] = input.valor_final;\n}\nif (sucRec) out.sucursal_interes = [sucRec.id];\n\nreturn [{ json: out }];\n"
      },
