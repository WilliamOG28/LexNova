    {
      "parameters": {
        "jsCode": "\n// Parsea el mensaje que el bot de la financiera manda a NUESTRO WhatsApp.\n// Formato de EJEMPLO (ajustar cuando llegue el real):\n//   Solicitud de crédito\n//   Nombre: Juan Pérez\n//   Teléfono: 5219991234567\n//   Estado: APROBADO\nconst t = $('When Executed by Another Workflow').first().json;\nconst raw = String(t.message_text || '');\nconst norm = raw.normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();\n\nfunction grab(labels){\n  for (const l of labels){\n    const re = new RegExp(l + '\\\\s*[:\\\\-]\\\\s*(.+)', 'i');\n    const m = norm.match(re);\n    if (m && m[1]) return m[1].split('\\n')[0].trim();\n  }\n  return '';\n}\n\n// Teléfono: por etiqueta o el primer bloque de 10+ dígitos del mensaje.\nlet tel = grab(['telefono','tel','celular','whatsapp','numero','num']);\nlet telDigits = tel.replace(/\\D/g,'');\nif (telDigits.length < 10){\n  const any = raw.replace(/\\D/g,' ').split(/\\s+/).filter(s=>s.length>=10).sort((a,b)=>b.length-a.length)[0] || '';\n  telDigits = any;\n}\ntelDigits = telDigits.slice(-10);\n\n// Nombre\nlet nombre = grab(['nombre','cliente','solicitante']);\n\n// Estado: aprobado / rechazado\nlet estado = null;\nconst APROB = ['aprobado','aprobada','aceptado','aceptada','autorizado','autorizada','apto','procede','preaprobado','pre-aprobado'];\nconst RECH  = ['rechazado','rechazada','denegado','denegada','no aprobado','no autorizado','no apto','no procede','declinado'];\nif (RECH.some(k => norm.includes(k))) estado = 'Rechazado';\nelse if (APROB.some(k => norm.includes(k))) estado = 'Aprobado';\n\n// Si el código no sacó estado O no sacó teléfono válido -> pedir ayuda al LLM.\nconst needs_llm = !(estado && telDigits.length === 10);\n\nreturn [{ json: {\n  msg_raw: raw,\n  parse_nombre: nombre || '',\n  parse_telefono: telDigits,\n  parse_estado: estado,\n  needs_llm,\n  via: needs_llm ? 'pendiente_llm' : 'codigo'\n}}];\n"
      },
