    {
      "parameters": {
        "jsCode": "\nfunction F(r){ return (r && r.fields && typeof r.fields==='object') ? r.fields : (r||{}); }\nfunction d10(s){ return String(s||'').replace(/\\D/g,'').slice(-10); }\nfunction norm(s){ return String(s||'').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/\\s+/g,' ').trim(); }\n\nconst p = $('Code · Reconciliar Parse').first().json;\nlet rows = [];\ntry { rows = $('Airtable · Get Leads Enviados').all().map(i=>i.json).filter(r => r && r.id); } catch(e) {}\n\nlet lead = null, match_via = 'ninguno';\n\n// Nivel 1: teléfono (últimos 10 dígitos) contra los leads que están \"Enviado a financiera\".\nif (p.telefono && p.telefono.length === 10) {\n  lead = rows.find(r => d10(F(r).user_id_canal) === p.telefono || d10(F(r).telefono) === p.telefono) || null;\n  if (lead) match_via = 'telefono';\n}\n\n// Nivel 2: nombre exacto (normalizado) — solo si es inequívoco (un único candidato).\nif (!lead && p.nombre) {\n  const n = norm(p.nombre);\n  const cands = rows.filter(r => norm(F(r).nombre) === n);\n  if (cands.length === 1) { lead = cands[0]; match_via = 'nombre'; }\n}\n\n// Nivel 3: sin match -> se reporta a Slack para empate manual (caso \"lo llenó un familiar\").\nconst hay_match = !!lead;\nconst f = hay_match ? F(lead) : {};\n\nreturn [{ json: {\n  hay_match, match_via,\n  lead_rec_id: hay_match ? lead.id : null,\n  user_id_canal: f.user_id_canal || null,\n  lead_nombre: f.nombre || null,\n  conversation_id: f.conversation_id || null,\n  sucursal_rec: (Array.isArray(f.sucursal_interes) && f.sucursal_interes[0]) || null,\n  asesor_rec: (Array.isArray(f.asesor_asignado) && f.asesor_asignado[0]) || null,\n  modelo_interes: f.modelo_interes || '',\n  estado: p.estado, parse_nombre: p.nombre, parse_telefono: p.telefono,\n  via_parse: p.via, msg_raw: p.msg_raw,\n  candidatos_revisados: rows.length\n}}];\n"
      },
