    {
      "parameters": {
        "promptType": "define",
        "text": "=Mensaje recibido de la financiera:\n\"\"\"\n{{ $('Code · Parse Financiera').first().json.msg_raw }}\n\"\"\"",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Eres un extractor de datos. Recibes un mensaje que el bot de una financiera envía a una agencia de motos para informar el resultado de una solicitud de crédito de un cliente.\nExtrae SOLO lo que el mensaje diga, en el JSON pedido:\n- estado: 'aprobado' si el crédito fue aprobado/aceptado/autorizado/apto; 'rechazado' si fue rechazado/denegado/no apto/no procede; 'desconocido' si el mensaje no lo dice con claridad.\n- nombre: el nombre del solicitante, si aparece. Si no, null.\n- telefono: el teléfono del solicitante, solo dígitos, si aparece. Si no, null.\nNo inventes datos. Si el mensaje no es sobre un resultado de crédito, estado='desconocido' y los demás null."
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -1824,
        160
      ],
      "id": "e564bfd2-9199-43cf-a5dd-51dc21b66f5f",
      "name": "LLM · Parse Financiera",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst c = $('Code · Parse Financiera').first().json;\nlet nombre = c.parse_nombre || '';\nlet telefono = c.parse_telefono || '';\nlet estado = c.parse_estado || null;\nlet via = c.via;\n\nlet llm = null;\ntry { const o = $('LLM · Parse Financiera').first().json; llm = o.output || o; } catch(e) {}\n\nif (llm && (llm.estado || llm.telefono || llm.nombre)) {\n  if (!estado && llm.estado && llm.estado !== 'desconocido') {\n    estado = (llm.estado === 'aprobado') ? 'Aprobado' : (llm.estado === 'rechazado' ? 'Rechazado' : null);\n  }\n  if (telefono.length !== 10 && llm.telefono) telefono = String(llm.telefono).replace(/\\D/g,'').slice(-10);\n  if (!nombre && llm.nombre) nombre = String(llm.nombre);\n  via = 'llm';\n}\n\nconst parse_ok = !!(estado && (telefono.length === 10 || nombre));\n\nreturn [{ json: {\n  msg_raw: c.msg_raw, nombre, telefono, estado, parse_ok, via\n}}];\n"
      },
